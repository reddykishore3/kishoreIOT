# Feed Forward Neural Network

import numpy as np
from sklearn.neural_network import MLPClassifier

# Input data
# XOR problem
X = np.array([
    [0, 0],
    [0, 1],
    [1, 0],
    [1, 1]
])

# Output
y = np.array([0, 1, 1, 0])

# Create Feed Forward Neural Network
model = MLPClassifier(
    hidden_layer_sizes=(4,),
    activation='relu',
    solver='lbfgs',
    max_iter=1000,
    random_state=1
)

# Train the network
model.fit(X, y)

# Test data
test_data = np.array([
    [0, 0],
    [0, 1],
    [1, 0],
    [1, 1]
])

# Prediction
prediction = model.predict(test_data)

print("Input:")
print(test_data)

print("\nPredicted Output:")
print(prediction)

