# Alpha-Beta Pruning

def minimax(depth, node_index, maximizing_player, values, alpha, beta):
    # Leaf node
    if depth == 3:
        return values[node_index]

    if maximizing_player:
        best = -9999

        for i in range(2):
            value = minimax(depth + 1, node_index * 2 + i,
                            False, values, alpha, beta)

            best = max(best, value)
            alpha = max(alpha, best)

            # Alpha-Beta pruning
            if beta <= alpha:
                break

        return best

    else:
        best = 9999

        for i in range(2):
            value = minimax(depth + 1, node_index * 2 + i,
                            True, values, alpha, beta)

            best = min(best, value)
            beta = min(beta, best)

            # Alpha-Beta pruning
            if beta <= alpha:
                break

        return best


# Leaf node values
values = [3, 5, 6, 9, 1, 2, 0, -1]

result = minimax(0, 0, True, values, -9999, 9999)

print("Optimal value:", result)

